/**
 * this is the main configuration file of your bit workspace.
 * for full documentation, please see: https://bit.dev/reference/workspace/workspace-json
 **/{
  "$schema": "https://static.bit.dev/teambit/schemas/schema.json",
  "teambit.workspace/workspace": {
    "name": "designsystem",
    "icon": "https://static.bit.dev/brands/bit-logo-min.png",
    "defaultDirectory": "designsystem/bit-cloud/components",
    "defaultScope": "konsumentverket-sverige.designsystem",
    "resolveAspectsFromNodeModules": true,
    "resolveEnvsFromRoots": true
  },
  "teambit.generator/generator": {
    "envs": [
      "bitdev.react/react-env"
    ]
  },
  "teambit.dependencies/dependency-resolver": {
    "policy": {
      "dependencies": {
        "prop-types": "^15.8.1",
        "react-google-recaptcha-v3": "^1.11.0",
        "react-hook-form": "^7.66.1"
      },
      "peerDependencies": {
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "@emotion/react": "^11.14.0",
        "@emotion/css": "^11.11.2"
      }
    },
    "linkCoreAspects": true,
    "packageManager": "teambit.dependencies/pnpm",
    "rootComponents": true
  },
  "teambit.pkg/pkg": {
    "packageJson": {
      "files": [
        "dist/**",
        "!dist/**/*.composition.*",
        "!dist/**/*.docs.*",
        "!dist/**/*.spec.*"
      ]
    }
  },
  /**
   * Ikonerna importeras avsiktligt fil för fil, till exempel
   * icons-system/dist/SystemIcons/ChevronRight/ChevronRight.js, i stället för via
   * paketets huvudfil.
   *
   * Huvudfilen är en barrel som återexporterar samtliga 113 ikoner med CommonJS. Den
   * kan därför inte tree-shakas: en enda import drog in alla ikoner i bundlen, vilket
   * utgjorde runt halva designsystemets vikt på varje sidladdning. Import per fil ger
   * den granularitet som behövs.
   *
   * ImportNonMainFiles är alltså inte ett fel här utan själva avsikten. Alternativet
   * inom bits modell vore att göra varje ikon till en egen komponent.
   */
  "teambit.component/issues": {
    "ignoreIssues": [
      "ImportNonMainFiles"
    ]
  },
  "teambit.workspace/workspace-config-files": {
    "enableWorkspaceConfigWrite": true
  }
}
